SERVER_HTTP_ADDR=":8080"
# The worker exposes Prometheus metrics and health here (the server uses SERVER_HTTP_ADDR/metrics).
WORKER_HTTP_ADDR=":8081"
ENV="development"

# Structured logging. JSON on stdout is the default for log collectors (Splunk,
# Fluentd); set LOG_FORMAT="text" for readable local development and LOG_LEVEL to
# one of "debug", "info", "warn", "error".
LOG_FORMAT="json"
LOG_LEVEL="info"

# Local observability stack ports (docker compose). Prometheus Web UI defaults to
# host port 9091.
PROMETHEUS_PORT="9091"
GRAFANA_PORT="3000"

# Primary (read-write) Postgres. Reads use DATABASE_REPLICA_URL if set, else this.
DATABASE_URL="postgres://minimart:minimart@localhost:5432/minimart?sslmode=disable"
# DATABASE_REPLICA_URL="postgres://minimart:minimart@localhost:5433/minimart?sslmode=disable"

# MongoDB for the notification domain (append-only record of sent notifications).
MONGO_URL="mongodb://localhost:27017"
MONGO_DATABASE="minimart"

# Kafka bootstrap brokers (comma-separated). Redpanda speaks the Kafka protocol.
KAFKA_BROKERS="localhost:9092"

# Kafka consumer retry and dead-letter behavior. A failed handler is retried with
# exponential backoff (full jitter); after the final attempt, or immediately for
# a permanent error, the message is published to <topic>.dlq with triage headers.
# The original message is acknowledged only after the DLQ publish succeeds.
# KAFKA_CONSUMER_MAX_ATTEMPTS="5"
# KAFKA_CONSUMER_RETRY_BASE_DELAY="500ms"
# KAFKA_CONSUMER_RETRY_MAX_DELAY="30s"
# KAFKA_CONSUMER_RESTART_MIN_BACKOFF="1s"
# KAFKA_CONSUMER_RESTART_MAX_BACKOFF="30s"

# Backpressure and lag. Each (topic, group) runs KAFKA_CONSUMER_CONCURRENCY
# supervised replicas; set this above 1 only when the source topic has multiple
# partitions. When KAFKA_CONSUMER_PAUSE_ENABLED is true the consumers pause reads
# while the write/read pool utilization is at or above the threshold, letting
# Kafka absorb the excess. The lag monitor samples consumer lag every interval.
# KAFKA_CONSUMER_CONCURRENCY="1"
# KAFKA_CONSUMER_PAUSE_ENABLED="false"
# KAFKA_CONSUMER_PAUSE_POOL_THRESHOLD="0.9"
# KAFKA_CONSUMER_PAUSE_DURATION="5s"
# KAFKA_CONSUMER_PAUSE_INTERVAL="1s"
# KAFKA_CONSUMER_LAG_ENABLED="true"
# KAFKA_CONSUMER_LAG_INTERVAL="30s"

# Redis backs the payment domain's idempotency-key cache and the global HTTP rate
# limiter. It is an accelerator only: the payments table's unique index on
# idempotency_key remains the authoritative guard, so a Redis outage degrades to
# database-only idempotency rather than allowing duplicates.
REDIS_URL="redis://localhost:6379/0"
# REDIS_REQUIRED_FOR_READINESS="false"
# REDIS_DIAL_TIMEOUT="2s"
# REDIS_READ_TIMEOUT="200ms"
# REDIS_WRITE_TIMEOUT="200ms"
# REDIS_POOL_TIMEOUT="200ms"
# REDIS_MAX_RETRIES="0"
# REDIS_POOL_SIZE="10"
# REDIS_BREAKER_FAILURE_THRESHOLD="5"
# REDIS_BREAKER_OPEN_DURATION="10s"
# REDIS_BREAKER_HALF_OPEN_SUCCESSES="2"
# RBAC_PERMISSIONS_LOCAL_CACHE_TTL="1m"
# PAYMENT_RECONCILE_INTERVAL="1m"
# PAYMENT_RECONCILE_AGE="5m"
# PAYMENT_RECONCILE_BATCH_SIZE="100"

# Global HTTP rate limiting, bucketed by the Idempotency-Key header (falling back
# to the client IP when absent): a token bucket allowing RATE_LIMIT_BURST tokens
# that refills RATE_LIMIT_REFILL_TOKENS per RATE_LIMIT_REFILL_INTERVAL.
# RATE_LIMIT_BURST="10"
# RATE_LIMIT_REFILL_TOKENS="10"
# RATE_LIMIT_REFILL_INTERVAL="1s"

# How long a payment's idempotency key is remembered (in Redis and for replay).
# PAYMENT_IDEMPOTENCY_TTL="24h"

# How long an order's idempotency key is remembered (in Redis and for replay).
# ORDER_IDEMPOTENCY_TTL="24h"
# ORDER_AUTO_CANCEL_INTERVAL="15s"
# ORDER_AUTO_CANCEL_BATCH_SIZE="100"

# How long a shipping quote's idempotency key is remembered (in Redis and for replay).
# SHIPPING_IDEMPOTENCY_TTL="24h"

# Fake payment provider thresholds (there is no real provider). Exactly this
# amount is declined; exactly this amount simulates a timeout. Any other amount
# is approved. Set either to 0 to disable that case.
# PAYMENT_FAKE_DECLINE_AMOUNT_CENTS="9999"
# PAYMENT_FAKE_TIMEOUT_AMOUNT_CENTS="7777"

# Transactional outbox relay (runs in the worker role). A domain writes events to
# the outbox table in the same transaction as its data; the relay polls and
# publishes them to Kafka at least once.
# OUTBOX_PROCESS_INTERVAL="5s"
# OUTBOX_LOCK_CHECKER_INTERVAL="30s"
# OUTBOX_CLEANUP_INTERVAL="5m"
# OUTBOX_MAX_LOCK_DURATION="1m"
# OUTBOX_RETENTION="24h"
# OUTBOX_MAX_ATTEMPTS="5"

# JWT authentication. The secret must be changed in production.
JWT_SECRET="minimart-local-dev-secret-change-me"
# AUTH_ACCESS_TOKEN_TTL="15m"
# AUTH_REFRESH_TOKEN_TTL="168h"
# AUTH_REMEMBER_ME_REFRESH_TOKEN_TTL="720h"

# Cookie encryption key (base64-encoded 32 bytes). Generate with: openssl rand -base64 32
# COOKIE_ENCRYPTION_KEY=""

# Optional cookie domain for production. Set when the SPA and API share a parent
# domain (for example ".example.com"); leave empty for host-only cookies.
# COOKIE_DOMAIN=""

# RBAC. ADMIN_USERNAMES is a comma-separated list of usernames granted the admin
# role at boot. RBAC_PERMISSIONS_CACHE_TTL controls Redis caching of permissions.
ADMIN_USERNAMES="andretads"
# RBAC_PERMISSIONS_CACHE_TTL="5m"

# Gateway (edge proxy). Edge-only by design - the app remains the JWT/RBAC authority.
# GATEWAY_HTTP_ADDR=":8080"
# GATEWAY_UPSTREAM="http://localhost:8080"
# GATEWAY_TRUSTED_PROXIES=""
# GATEWAY_CORS_ORIGINS="*"
# GATEWAY_CORS_METHODS="GET,POST,PUT,PATCH,DELETE,OPTIONS"
# GATEWAY_CORS_HEADERS="*"
# GATEWAY_CORS_EXPOSE_HEADERS="X-Request-ID"
# GATEWAY_CORS_CREDENTIALS="true"
# GATEWAY_CORS_MAX_AGE="3600"

# S3-compatible storage (MinIO, floci, AWS S3) for product and avatar images.
# S3_ENDPOINT=""              # Empty for AWS S3, set for MinIO/floci (e.g., http://localhost:9000)
#                              # In Docker Compose, use the internal container port: http://floci:4566
# S3_PUBLIC_ENDPOINT=""       # Browser-facing S3 endpoint for presigned URLs; defaults to S3_ENDPOINT
#                              # In Docker Compose, use the host port: http://localhost:9000
# S3_BUCKET="minimart"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY="minioadmin"
# S3_SECRET_KEY="minioadmin"
# S3_USE_PATH_STYLE="true"   # Required for MinIO/floci
# S3_PRESIGN_TTL="1h"
# S3_MAX_UPLOAD_SIZE_MB="5"

# Resend email service (https://resend.com).
# RESEND_API_KEY is required to send real emails; if unset, emails are only logged.
# RESEND_API_KEY=""
# RESEND_FROM="MiniMart <onboarding@resend.dev>"
# RESEND_REPLY_TO=""

# AI Moderation (Llama Guard 3 via Ollama)
# MODERATION_ENABLED="true"
# MODERATION_ENDPOINT="http://localhost:11434"
# MODERATION_MODEL="llama-guard3:1b"
# MODERATION_TIMEOUT="30s"

# Kafka authentication (Confluent Cloud). Leave unset for local Redpanda.
# KAFKA_USERNAME=""
# KAFKA_PASSWORD=""
# KAFKA_SASL_MECHANISM="plain"
# KAFKA_TLS_ENABLED="false"

# Sentry (optional; backend SDK wiring is a follow-up).
# SENTRY_DSN=""

# PostHog is frontend-only; configured at build time (see render.yaml).
