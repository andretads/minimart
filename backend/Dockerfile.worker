# Worker image — background jobs/outbox only
#
# Role:
#   worker  — no API; /metrics, /livez, /readyz on WORKER_HTTP_ADDR (default :8081)
#
# Run the worker: docker run <image> worker
#
# Probes:
#   worker: GET /livez and /readyz on WORKER_HTTP_ADDR (e.g. :8081)
#
# Environment variables:
#   Common:     DATABASE_URL, DATABASE_REPLICA_URL, MONGO_URL, MONGO_DATABASE,
#               REDIS_URL, KAFKA_BROKERS, ENV, LOG_LEVEL, LOG_FORMAT
#   Worker:     WORKER_HTTP_ADDR, OUTBOX_PROCESS_INTERVAL, OUTBOX_LOCK_CHECKER_INTERVAL,
#               OUTBOX_CLEANUP_INTERVAL, OUTBOX_MAX_LOCK_DURATION, OUTBOX_RETENTION,
#               OUTBOX_MAX_ATTEMPTS, PAYMENT_IDEMPOTENCY_TTL, ORDER_IDEMPOTENCY_TTL,
#               PAYMENT_FAKE_DECLINE_AMOUNT_CENTS, PAYMENT_FAKE_TIMEOUT_AMOUNT_CENTS

# syntax=docker/dockerfile:1

# Build arguments
ARG GO_VERSION=1.27.4
ARG APP_VERSION=dev

# Stage 1: Dependencies (cache go module downloads)
FROM golang:${GO_VERSION}-alpine AS deps
WORKDIR /build
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod download && go mod verify

# Stage 2: Builder (compile the static binary)
FROM golang:${GO_VERSION}-alpine AS builder
RUN apk add --no-cache ca-certificates tzdata

WORKDIR /build
COPY . .

ARG APP_VERSION
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build \
    -trimpath -buildvcs=false \
    -ldflags="-w -s -X minimart/cmd.version=${APP_VERSION}" \
    -o /app/minimart .

# Stage 3: Runtime (scratch with minimal files)
FROM scratch

# The global APP_VERSION is only available in FROM lines; re-declare here for LABEL.
ARG APP_VERSION

# Image metadata
LABEL maintainer="andretads@gmail.com"
LABEL version="${APP_VERSION}"

# Essential file systems from builder
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo

# Binary
COPY --from=builder /app/minimart /app/minimart

# Working directory
WORKDIR /app

# Ports: 8081 (metrics)
EXPOSE 8081

# Security: run as non-root user
USER 65534:65534

# Graceful shutdown on SIGTERM
STOPSIGNAL SIGTERM

# One binary, worker role
ENTRYPOINT ["/app/minimart"]
CMD ["worker"]