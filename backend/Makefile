.PHONY: build server worker migrate gateway dlq-replay test coverage test-integration lint lint-fix fmt compose compose-moderation compose-down sqlc new-migration tidy docs vuln modernize

# Version stamped into the binary via -ldflags. Override: make build VERSION=v1.2.3
VERSION ?= dev
LDFLAGS := -X minimart/cmd.version=$(VERSION)

# Packages injected into -coverpkg so coverage is measured across the whole
# module (excluding the cmd wiring package).
COVER_PKGS := $(shell go list ./... | grep -v "/cmd" | paste -sd, -)

# PGO profile path (generated by running the binary with representative workload)
PGO_PROFILE ?= default.pgo

# Build the single binary. Use PGO if profile exists.
build:
	@if [ -f $(PGO_PROFILE) ]; then \
		go build -trimpath -ldflags "$(LDFLAGS)" -pgo=$(PGO_PROFILE) -o minimart .; \
	else \
		go build -trimpath -ldflags "$(LDFLAGS)" -o minimart .; \
	fi

# Build with PGO profile generation enabled (run binary with workload to generate profile).
build-pgo-gen:
	go build -trimpath -ldflags "$(LDFLAGS)" -pgo=auto -o minimart .

# Generate PGO profile by running the server with a brief warmup workload.
# Requires a running Postgres and Redis (e.g., via 'make compose').
pgo-profile:
	@echo "Starting server for PGO profile generation..."
	@./minimart server & SERVER_PID=$$!; \
	sleep 5; \
	echo "Warming up with requests..."; \
	for i in $$(seq 1 100); do \
		curl -s http://localhost:8080/livez > /dev/null || true; \
		curl -s http://localhost:8080/readyz > /dev/null || true; \
		curl -s http://localhost:8080/v1/showcase/products > /dev/null || true; \
	done; \
	kill $$SERVER_PID; \
	wait $$SERVER_PID 2>/dev/null || true; \
	echo "PGO profile generated at $(PGO_PROFILE)"

# Run each role locally (one binary, four subcommands).
server:
	go run -ldflags "$(LDFLAGS)" . server

worker:
	go run -ldflags "$(LDFLAGS)" . worker

migrate:
	go run -ldflags "$(LDFLAGS)" . migrate

gateway:
	go run -ldflags "$(LDFLAGS)" . gateway

# Replay a topic's dead-letter queue. Usage:
#   make dlq-replay topic=order-placed [group=dlq-replay] [dry_run=1]
dlq-replay:
	@test -n "$(topic)" || (echo "usage: make dlq-replay topic=<original-topic> [group=<group>] [dry_run=1]"; exit 2)
	go run -ldflags "$(LDFLAGS)" . dlq-replay -topic=$(topic) $(if $(group),-group=$(group)) $(if $(dry_run),-dry-run)

test:
	go test -race -shuffle=on ./...

# Run the suite measuring cross-package coverage, then open the HTML report.
coverage:
	go test -coverpkg=$(COVER_PKGS) -coverprofile=coverage.out ./...
	go tool cover -html=coverage.out

# Lint and format with golangci-lint (v2).
lint:
	golangci-lint run --build-tags=integration ./...

lint-fix:
	golangci-lint run --fix --build-tags=integration ./...

fmt:
	golangci-lint fmt ./...

# Bring the local Postgres + Redpanda stack up / down.
compose:
	docker compose up -d

compose-moderation:
	docker compose --profile moderation up -d

compose-down:
	docker compose down --rmi local

compose-down-moderation:
	docker compose --profile moderation down --rmi local

# Regenerate the type-safe query code from queries.sql (needs the sqlc CLI).
sqlc:
	go tool sqlc generate

# Create a new timestamped migration:  make new-migration name=create_widgets
new-migration:
	go tool dbmate new $(name)

tidy:
	go mod tidy

# Run the integration tests. Each package spins up its own ephemeral dependencies
# via testcontainers-go - Postgres (migrated with db/migrations), Kafka, and
# MongoDB as each domain needs them - so no docker-compose stack or
# pre-provisioned database is required, just a running Docker daemon.
test-integration:
	go test -count=1 -timeout=20m -tags=integration ./internal/...

# Vulnerability check using govulncheck.
vuln:
	go run golang.org/x/vuln/cmd/govulncheck@latest ./...

# Modernization check: runs go fix and fails if any changes would be made.
modernize:
	@output=$$(go fix -diff -tags=integration ./...); \
	if [ -n "$$output" ]; then \
		echo "go fix would make changes:"; \
		echo "$$output"; \
		exit 1; \
	fi

# Regenerate the OpenAPI docs (docs/) from handler annotations.
docs:
	go tool swag init -g main.go -o docs --parseInternal