{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ci": "ng test --watch=false",
    "e2e": "cypress run",
    "e2e:open": "cypress open",
    "e2e:live": "cypress run --env live=1 --spec cypress/e2e/live/**/*.cy.ts"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/animations": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@sentry/angular": "^11.15.0",
    "posthog-js": "^1.453.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.8.0",
    "cypress": "^16.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-cypress": "^7.1.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "8.73.0",
    "vitest": "^5.1.1"
  }
}
